# real world experience to exclude things people often accidently commit

#project
dist/

package.nls.de.json
package.nls.es.json
package.nls.fr.json
package.nls.id.json
package.nls.it.json
package.nls.ja.json
package.nls.ko.json
package.nls.pt-br.json
package.nls.ru.json
package.nls.uk.json
package.nls.vi.json
package.nls.zh-cn.json

!src/i18n/*.*

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Coverage directory used by tools like istanbul
*.lcov

# Coverage
coverage/

# Dependency directories
node_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Yarn Integrity file
.yarn-integrity

# Temporary folders
tmp/
temp/

# VS Code extension specific
out/
.vscode-test/
.vscode-test-electron/


# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.idea/
*.swp
*.swo
*~

# Test files and coverage
test-results/
*.lcov

# Build artifacts
lib/
build/
dist/

# Package files
*.7z
*.rar
*.7zip
*.zip
*.tgz
*.tar.gz

# Windows
.bat
.ps1
.dll

# Unapproved Images
*.jpg
*.jpeg
*.ico
*.bmp
*.webp
*.svg
*.tiff

.env
*.env.*
!src/detection/__data__/*.env.*

# Release packages
release/
out-test/
benchmark-results.json

# Zed extension build output (Cargo.lock IS committed — it pins the wasm build)
zed/target/
mcp/server.js
mcp/LICENSE

# The Rust CLI's build output. Everything under it is regenerated by
# `cargo build`, including a whole unpacked copy of the crate under
# `target/package/` — which git will happily track as thousands of files
# if nothing says otherwise.
crate/target/

# The shared corpus is the contract between the two frontends, so every
# file in it must be tracked whatever its extension. Without this, the
# `*.log` rule above silently drops the corpus's log document and CI
# fails on a file that is present on every machine that wrote it.
!crate/fixtures/
!crate/fixtures/**
