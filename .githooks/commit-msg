#!/bin/sh
# Conventional-commit gate. Enabled by `git config core.hooksPath .githooks`.
# CI runs the same check on the pushed range, so `--no-verify` delays the
# failure rather than avoiding it.
#
# Written in POSIX shell rather than calling out to Node: the extension repos
# share a scripts/commit-lint.js, and this repo has no JavaScript in it at all.
# A hook that needs a runtime the repo does not otherwise use is a hook that
# stops working the first time someone clones without it.
set -eu

msg_file="$1"
subject=$(head -n 1 "$msg_file")

# Merge and revert commits are generated by git; they are not ours to shape.
case "$subject" in
    "Merge "* | "Revert "*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._,/ -]+\))?!?: .+'

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
    echo "commit-msg: subject must be a conventional commit." >&2
    echo "  got:      $subject" >&2
    echo "  expected: <type>(<optional scope>): <imperative subject>" >&2
    echo "  types:    feat fix docs style refactor perf test build ci chore revert" >&2
    exit 1
fi
